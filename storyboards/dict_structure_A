# Storyboard - Prepared dict (tcl)
# 
# This structure is transformed out of Syntax Variant A & B 
# in order for it to be read by Expression Builder
# The following structure is based on dict (tcl) syntax
# Each line is basically a prepared command for a nested dict
# 
# Syntax A / B --> this structure (transformed dict) --> Expression Builder --> instances 

video1 videoID myVideoID
video1 title "A Sample Video"
video1 videoLink videoLinkPlaceholder
video1 length 60

highlight1 videoref myVideoID
highlight1 title "A sample highlight"
highlight1 starttime 5
highlight1 endtime 50

highlight2 videoref myVideoID
highlight2 title "Another highlight"
highlight2 starttime 20
highlight2 endtime 60

video2 title "This is the second video"
video2 videoSource videoLinkPlaceholder
video2 length 120

highlight3 starttime 10
highlight3 endtime 20
highlight3 title "This is another highlight"
highlight3 crop true

